<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug overlay only.

  The React Native template permits cleartext wholesale in debug through the
  `${usesCleartextTraffic}` manifest placeholder. A network security config takes precedence over
  that flag on API 24+, so this narrows the permission to the two hosts that actually need it
  instead of every host on the internet.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
